# Public URL of the deployed site (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (https://resend.com). Without these the form shows a friendly "unavailable" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: a sender on a domain verified in Resend. Defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=

# Optional: raises the GitHub API rate limit for the activity section
GITHUB_TOKEN=
